#include <stdio.h>
#include <limits.h>

#define FIXED_CHARGE_PAISE 5000LL
#define RATE2_PAISE 225LL
#define RATE3_PAISE 450LL

long long bill_paise(long long units)
{
    long long total = FIXED_CHARGE_PAISE;

    if (units > 100 && units <= 200)
        total += (units - 100) * RATE2_PAISE;
    else if (units > 200)
    {
        total += 100 * RATE2_PAISE;
        total += (units - 200) * RATE3_PAISE;
    }

    return total;
}

int main(void)
{
    long long bills[] = {4000, 60000, 800000};
    int n = sizeof(bills) / sizeof(bills[0]);

    printf("Size of int: %zu bytes\n", sizeof(int));
    printf("Size of long: %zu bytes\n", sizeof(long));
    printf("Size of long long: %zu bytes\n", sizeof(long long));

    printf("INT_MAX = %d\n", INT_MAX);
    printf("LONG_MAX = %ld\n", LONG_MAX);
    printf("LLONG_MAX = %lld\n\n", LLONG_MAX);

    for (int i = 0; i < n; i++)
    {
        long long total = bill_paise(150) * bills[i];
        double floatTotal = (double)total / 100.0;

        printf("Number of bills: %lld\n", bills[i]);
        printf("Integer-paise total: %lld paise\n", total);
        printf("Total in rupees: Rs %.2f\n", floatTotal);
        printf("-------------------------\n");
    }

    return 0;
}

