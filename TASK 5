#include <stdio.h>

#define SLAB1_UNITS 100
#define SLAB2_UNITS 200
#define RATE1_PAISE 0
#define RATE2_PAISE 225
#define RATE3_PAISE 450
#define FIXED_CHARGE_PAISE 5000LL

#ifdef DEBUG
#define DEBUG_PRINT(value) \
    printf("DEBUG: %s = %lld\n", #value, (long long)(value))
#else
#define DEBUG_PRINT(value) ((void)0)
#endif

long long compute_bill_paise(int units);

long long compute_bill_paise(int units)
{
    long long paise = FIXED_CHARGE_PAISE;

    if (units > SLAB1_UNITS && units <= SLAB2_UNITS)
        paise += (long long)(units - SLAB1_UNITS) * RATE2_PAISE;

    if (units > SLAB2_UNITS)
    {
        paise += (long long)(SLAB2_UNITS - SLAB1_UNITS) * RATE2_PAISE;
        paise += (long long)(units - SLAB2_UNITS) * RATE3_PAISE;
    }

    DEBUG_PRINT(units);
    DEBUG_PRINT(paise);

    return paise;
}

int main(void)
{
    int units = 150;
    long long total = compute_bill_paise(units);

    printf("Units consumed: %d\n", units);
    printf("Total bill: Rs %lld.%02lld\n",
           total / 100, total % 100);

    return 0;
}

OUTPUT:

Units consumed: 150
Total bill: Rs 162.50
