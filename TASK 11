#include <stdio.h>
#include <limits.h>

#define SLAB1_UNITS 100
#define SLAB2_UNITS 200
#define RATE2_PAISE 225LL
#define RATE3_PAISE 450LL
#define FIXED_CHARGE_PAISE 5000LL

long long compute_bill_paise(long long units)
{
    long long total = FIXED_CHARGE_PAISE;

    if (units > SLAB1_UNITS && units <= SLAB2_UNITS)
        total += (units - SLAB1_UNITS) * RATE2_PAISE;
    else if (units > SLAB2_UNITS)
    {
        total += (SLAB2_UNITS - SLAB1_UNITS) * RATE2_PAISE;
        total += (units - SLAB2_UNITS) * RATE3_PAISE;
    }

    return total;
}

